# Eco Fusion Chatbot Environment Configuration
# Copy this file to .env and fill in your values

# Required: Hugging Face Integration
HF_TOKEN=your_hugging_face_token_here
HF_API_KEY=your_hugging_face_api_key_here
HF_MODEL_NAME=microsoft/DialoGPT-medium

# Required: Email Configuration
ADMIN_EMAIL=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: CRM Integration
CRM_WEBHOOK_URL=https://your-crm-webhook.com

# Optional: Google Calendar Integration
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key
GOOGLE_CALENDAR_ID=your_calendar_id
GOOGLE_CALENDAR_CREDENTIALS_FILE=google-calendar-credentials.json

# Optional: Legacy Calendar Integration
CALENDAR_BASE_URL=https://calendly.com/ecofusion

# Optional: Rocket.Chat Integration
ROCKETCHAT_WEBHOOK_TOKEN=your_token

# Optional: WhatsApp/Telegram (if using direct integration)
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_ID=your_phone_id
TELEGRAM_TOKEN=your_telegram_token

# Server Configuration
RASA_SERVER_PORT=5005
ACTIONS_SERVER_PORT=5055
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
ANALYTICS_ENABLED=true