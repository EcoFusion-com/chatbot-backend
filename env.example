# Hugging Face API Configuration
# Use this for the enhanced model via Hugging Face router
HF_TOKEN=your_huggingface_token_here

# Fallback to old HF API (optional)
HF_API_KEY=your_huggingface_api_key_here
HF_MODEL_NAME=facebook/blenderbot-400M-distill

# Google Calendar Integration
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_CALENDAR_CREDENTIALS_FILE=path/to/google-calendar-credentials.json

# Email Configuration
ADMIN_EMAIL=admin@ecofusion.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# CRM Integration
CRM_WEBHOOK_URL=https://your-crm-webhook-url.com/webhook

# Optional: Custom model endpoint
# OPENAI_BASE_URL=https://router.huggingface.co/v1
